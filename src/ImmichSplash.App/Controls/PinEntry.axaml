<!-- Six PIN boxes with an invisible text box on top that takes the typing. Used by the locked folder and the
     "move to locked folder" prompt, so both look and behave the same. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:c="using:ImmichSplash.App.Controls"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             x:Class="ImmichSplash.App.Controls.PinEntry"
             x:DataType="c:PinEntry" HorizontalAlignment="Center">
  <UserControl.Styles>
    <Style Selector="Border.pinBox">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    </Style>
    <!-- While typing: the next box is outlined and has a blinking caret (only while the PIN field has focus). -->
    <Style Selector="ItemsControl.typing Border.pinBox.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Rectangle.caret">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Fill" Value="{DynamicResource AppPrimaryBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.typing Border.pinBox.active Rectangle.caret">
      <Setter Property="IsVisible" Value="True" />
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="49%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Panel>
    <ItemsControl Name="Boxes" IsHitTestVisible="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PinBox">
          <Border Classes="pinBox" Classes.active="{Binding Active}">
            <Panel>
              <Ellipse Width="10" Height="10" Fill="{DynamicResource AppTextBrush}" IsVisible="{Binding Filled}" />
              <Rectangle Classes="caret" />
            </Panel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBox Name="Input" MaxLength="6" PasswordChar="●" Opacity="0" Background="Transparent" BorderThickness="0"
             l:Tr.Watermark="PIN code" AutomationProperties.Name="PIN code" />
  </Panel>
</UserControl>
