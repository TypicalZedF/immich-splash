<!-- The locked folder's PIN prompt. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:c="using:ImmichSplash.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.LockedPinSection"
             x:DataType="vm:PhotosViewModel">
  <Border Classes="card" Width="520" Padding="32,34,32,30" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="{Binding ShowLockedPrompt}">
    <StackPanel Spacing="22">
      <mi:MaterialIcon Kind="LockOutline" Width="64" Height="64" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding PinPrompt}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsCreatingPin}"
                 l:Tr.Text="You'll use it here and in Immich's web and mobile apps. Forgot it? Your Immich password can reset it; if you sign in with SSO, only a server admin can." />
      <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !CanEnterPin}"
                 l:Tr.Text="Photos here are hidden from your timeline, albums and search." />

      <c:PinEntry Name="PinEntry" Pin="{Binding Pin}" IsEntryEnabled="{Binding !IsUnlocking}" IsVisible="{Binding CanEnterPin}" />

      <!-- Remembered on this PC: Windows Hello instead of typing. -->
      <Button Classes="ghost" HorizontalAlignment="Center" Command="{Binding UnlockWithHelloCommand}" IsVisible="{Binding CanUnlockWithHello}">
        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Fingerprint" /><TextBlock Text="{Binding HelloButtonText}" /></StackPanel>
      </Button>
      <CheckBox HorizontalAlignment="Center" IsChecked="{Binding RememberPin}" IsVisible="{Binding ShowRememberPin}">
        <TextBlock Text="{Binding RememberPinText}" TextWrapping="Wrap" MaxWidth="400" />
      </CheckBox>

      <TextBlock Classes="caption" Foreground="{DynamicResource AppDangerBrush}" Text="{Binding LockedMessage}" TextWrapping="Wrap"
                 TextAlignment="Center" IsVisible="{Binding LockedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Button Classes="secondary" HorizontalAlignment="Center" MinWidth="96" HorizontalContentAlignment="Center" Command="{Binding CancelPinCommand}"
              Background="{DynamicResource AppTextBrush}" Foreground="{DynamicResource AppCardBrush}">
        <TextBlock l:Tr.Text="Cancel" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>
