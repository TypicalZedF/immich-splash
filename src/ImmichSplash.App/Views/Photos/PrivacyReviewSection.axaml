<!-- Suggestions for the locked folder from the on-device privacy check. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.PrivacyReviewSection"
             x:DataType="vm:PhotosViewModel">
  <Panel>
    <ContentControl Content="{Binding Privacy}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:PrivacyReviewViewModel">
          <!-- One scroll for the whole page, so it works on small screens -->
          <Grid RowDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="28,0,24,24">
              <Border Classes="card" Padding="16,14" CornerRadius="16">
                <Grid ColumnDefinitions="Auto,*">
                  <mi:MaterialIcon Kind="ShieldLockOutline" Width="26" Height="26" VerticalAlignment="Top" Margin="0,2,14,0"
                                   Foreground="{DynamicResource AppPrimaryBrush}" />
                  <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock TextWrapping="Wrap"
                               l:Tr.Text="Finds photos you may want in the locked folder: nudity, payment cards, IDs, bank and tax papers, passwords and medical records. Everything is checked on this PC; your photos and the results are never sent anywhere, and nothing is moved without you." />
                    <WrapPanel Orientation="Horizontal">
                      <ToggleSwitch IsChecked="{Binding IsEnabled}" l:Tr.Content="Check my library" MinWidth="250" Margin="0,0,16,4" />
                      <ToggleSwitch IsChecked="{Binding UseGpu}" IsVisible="{Binding OffersGpu}" l:Tr.Content="Use the graphics card" MinWidth="250" Margin="0,0,16,4" />
                      <ToggleSwitch IsChecked="{Binding OnlyWhenIdle}" l:Tr.Content="Only when I'm not using the PC" MinWidth="250" Margin="0,0,16,4" />
                      <ToggleSwitch IsChecked="{Binding Thorough}" IsEnabled="{Binding !IsDownloadingThorough}" l:Tr.Content="Thorough check" MinWidth="250" Margin="0,0,16,4" />
                    </WrapPanel>
                    <!-- Thorough check: CLIP, downloaded once when turned on -->
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="{Binding ThoroughText}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDownloadingThorough}">
                        <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="1" Width="240" Height="4" VerticalAlignment="Center" />
                        <Button Classes="ghost" Padding="8,4" Command="{Binding CancelDownloadCommand}" l:Tr.Content="Cancel" />
                      </StackPanel>
                      <Button Classes="ghost" Padding="8,4" Margin="-8,0,0,0" HorizontalAlignment="Left" Command="{Binding RemoveThoroughCommand}"
                              IsVisible="{Binding CanRemoveThorough}" l:Tr.Content="Remove the download" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,2" />
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="6" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*">
                          <mi:MaterialIcon Kind="Loading" Classes="spin" Width="14" Height="14" IsVisible="{Binding IsWorking}" />
                          <TextBlock Grid.Column="1" Classes="caption" Margin="8,0,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" IsVisible="{Binding ShowProgress}" Height="4" />
                      </StackPanel>
                      <!-- With the setting off: check the library just this once -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsEnabled}">
                        <Button Classes="secondary" Command="{Binding ScanOnceCommand}" IsVisible="{Binding !IsOneTimeRunning}"
                                l:Tr.Tip="Checks your library now and stops when it's done. New photos aren't checked until you do it again.">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ShieldSearch" Width="16" Height="16" />
                            <TextBlock l:Tr.Text="Check once now" />
                          </StackPanel>
                        </Button>
                        <Button Classes="secondary" Command="{Binding StopOnceCommand}" IsVisible="{Binding IsOneTimeRunning}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Stop" Width="16" Height="16" />
                            <TextBlock l:Tr.Text="Stop checking" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Button Classes="ghost" Command="{Binding ToggleDetailsCommand}" Padding="8,4" Margin="-8,0,0,0" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" />
                        <TextBlock l:Tr.Text="How this works, and what it can see" FontWeight="Medium" IsVisible="{Binding !ShowDetails}" />
                        <TextBlock l:Tr.Text="Hide how this works" FontWeight="Medium" IsVisible="{Binding ShowDetails}" />
                        <mi:MaterialIcon Kind="ChevronDown" Width="16" Height="16" IsVisible="{Binding !ShowDetails}" />
                        <mi:MaterialIcon Kind="ChevronUp" Width="16" Height="16" IsVisible="{Binding ShowDetails}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <!-- Transparency (right under the card it opens from): where it runs, what leaves the PC, what's kept, the models and the rules -->
              <Border Classes="card" Padding="20,18" CornerRadius="16" IsVisible="{Binding ShowDetails}">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" l:Tr.Text="How this works" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost icon" Command="{Binding ToggleDetailsCommand}" l:Tr.Tip="Hide">
                      <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
                    </Button>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" l:Tr.Text="Exactly what it does, step by step" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="1. Asks your Immich server for the list of your photos and videos (the timeline and the archive; never the locked folder or the trash)." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="2. For each one it hasn't checked yet, downloads its preview picture from your server into memory, the same picture you see when you scroll your photos. For videos, that's a still frame." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="3. Shrinks the picture and gives it to the nudity detector, which looks for exposed body parts and says how sure it is. With the thorough check on, CLIP also describes the whole picture and LAION's detector scores that description, which catches drawings, art and game scenes." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="4. Gives the picture to the text finder, then reads each line of text it found." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="5. Checks that text against the rules below (card numbers, ID wording and so on)." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="6. Writes down only the photo's ID, the kind of thing found and how sure it is, then throws the picture and the text away." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="7. Moves on to the next one. It never moves, changes or deletes anything: you decide in the list on this page." />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" l:Tr.Text="Where it runs" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding RunsOn}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               l:Tr.Text="Each photo's preview (about 1440 pixels) is fetched from your own Immich server, checked in memory and let go. Previews aren't saved to disk." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               l:Tr.Text="It waits while the PC is on battery or on a metered connection." />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" l:Tr.Text="What leaves this PC" />
                    <TextBlock TextWrapping="Wrap" l:Tr.Text="Nothing. The check only talks to your own Immich server:" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ServerHost, StringFormat='• {0}'}" FontWeight="Medium" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               l:Tr.Text="It lists your photos and fetches their previews, and when you click “Move to locked folder” it asks your server to move them. No other server, account or analytics is involved." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               l:Tr.Text="The one exception is the optional thorough check: turning it on downloads its model once from huggingface.co (Immich's published copy of CLIP). Only the model file is downloaded; nothing about your photos is sent, and the file is checked against its published fingerprint." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding TelemetryText}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" l:Tr.Text="What's kept" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               l:Tr.Text="For each photo: its Immich ID, what kind of thing was found (for example “Payment card”), how sure the check is, and your choice. Never the picture, and never the text read from it. Stored in the app's local database:" />
                    <SelectableTextBlock Classes="caption" Text="{Binding DatabasePath}" TextWrapping="Wrap" />
                    <Button Classes="secondary" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding ForgetResultsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                        <TextBlock l:Tr.Text="Forget all results" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Classes="h3" l:Tr.Text="The models" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               l:Tr.Text="Open-source models that run with ONNX Runtime. They ship inside the app, except the thorough check's CLIP, which is downloaded when you turn it on. Their fingerprints (SHA-256) let anyone confirm they're the published files." />
                    <ItemsControl ItemsSource="{Binding Models}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrivacyModelViewModel">
                          <StackPanel Spacing="2" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            <SelectableTextBlock Classes="caption tertiary" Text="{Binding Fingerprint}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding OpenModelsFolderCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                        <TextBlock l:Tr.Text="Open the models folder" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" l:Tr.Text="The rules for text" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="• Payment card: a 13–19 digit number that passes the card checksum, or a card brand together with “valid thru”, “CVV” or similar." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="• ID document: a passport's machine-readable lines, or “passport”, “driver license” and the like together with “date of birth”, “expires” and so on." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="• Bank or tax details: a bank account number (IBAN, checksum-verified), “account number”, “routing number”, “sort code”, tax forms, pay slips." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="• Passwords or codes: “recovery codes”, “seed phrase”, “private key”, “Wi-Fi password”, a numbered list of 12+ words, or a username and password together." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="• Medical: “prescription”, “diagnosis”, “medical record”, “lab results”, or several medical words together." />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="Single common words (like “bank” on a sign, or “Visa” on a receipt) aren't enough on their own." />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" l:Tr.Text="Check it yourself" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" l:Tr.Text="Immich Splash is open source. This is the code that does the check:" />
                    <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding OpenSourceCommand}" ToolTip.Tip="{Binding SourceUrl}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CodeBraces" Width="16" Height="16" />
                        <TextBlock l:Tr.Text="See the code on GitHub" />
                      </StackPanel>
                    </Button>
                    <SelectableTextBlock Classes="caption tertiary" Text="{Binding SourceUrl}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding ToggleDetailsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <mi:MaterialIcon Kind="ChevronUp" Width="16" Height="16" />
                      <TextBlock l:Tr.Text="Hide how this works" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="16,12,16,6" CornerRadius="16" IsVisible="{Binding HasItems}">
                <StackPanel Spacing="6">
                  <!-- Filters: what kind of thing, and how sure the check is -->
                  <StackPanel Spacing="8" IsVisible="{Binding HasKindFilters}">
                    <ItemsControl ItemsSource="{Binding KindFilters}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrivacyKindFilter">
                          <ToggleButton Classes="filterChip" IsChecked="{Binding IsOn}" Content="{Binding Label}" Margin="0,0,8,6" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,200,Auto,*,Auto" IsVisible="{Binding ShowConfidenceFilter}">
                    <TextBlock Classes="secondary" l:Tr.Text="How sure" VerticalAlignment="Center" Margin="0,0,10,0"
                               l:Tr.Tip="For nudity, it's the detector's own score. For text, how strong the match is: a card number that passes the card checksum or a passport's machine-readable lines count as 95%, word matches as 80%." />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MinConfidence}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding MinConfidenceText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="caption" Text="{Binding FilterSummary}" VerticalAlignment="Center" />
                      <Button Classes="ghost" Padding="8,3" l:Tr.Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                              IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,2">
                    <CheckBox IsChecked="{Binding ShowPictures}" l:Tr.Content="Show pictures" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" l:Tr.Content="Select all" Command="{Binding SelectAllCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PrivacySuggestionViewModel">
                    <StackPanel Width="176" Margin="0,0,10,12" Spacing="5">
                      <Button Classes="tile privacyTile" Classes.selected="{Binding IsSelected}" Classes.reveal="{Binding Revealed}"
                              Width="176" Height="176" Command="{Binding ToggleSelectCommand}" AutomationProperties.Name="{Binding Reason}">
                        <Panel>
                          <!-- Blurred unless "Show pictures" is on or the pointer is over it -->
                          <Image Classes="sharp" Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          <Image Classes="blurred" Source="{Binding Blurred}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                          <mi:MaterialIcon Classes="blurred" Kind="EyeOffOutline" Width="26" Height="26" Foreground="White" Opacity="0.85"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Panel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <Ellipse Width="22" Height="22" Fill="White" IsVisible="{Binding IsSelected}" />
                            <mi:MaterialIcon Kind="CheckCircle" Width="26" Height="26" IsVisible="{Binding IsSelected}" Foreground="{DynamicResource AppPrimaryBrush}" />
                            <mi:MaterialIcon Kind="CheckboxBlankCircleOutline" Width="24" Height="24" Foreground="White" IsVisible="{Binding !IsSelected}" />
                          </Panel>
                          <Button Classes="ghost icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                  Command="{Binding OpenCommand}" l:Tr.Tip="View" Background="#66000000">
                            <mi:MaterialIcon Kind="ArrowExpand" Width="16" Height="16" Foreground="White" />
                          </Button>
                        </Panel>
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0">
                        <TextBlock Classes="caption" Text="{Binding Reason}" TextWrapping="Wrap" MaxWidth="110" />
                        <TextBlock Classes="caption tertiary" Text="{Binding ConfidenceText}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,40,0,0" MaxWidth="420" IsVisible="{Binding ShowEmpty}">
                <mi:MaterialIcon Kind="ShieldCheckOutline" Width="36" Height="36" Foreground="{DynamicResource AppPrimaryBrush}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" l:Tr.Text="Nothing to review right now." />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <!-- Pinned, so the actions stay in reach however long the list is -->
          <Border Grid.Row="1" Classes="card" Padding="16,10" CornerRadius="16" Margin="28,4,24,16" IsVisible="{Binding HasItems}">
            <Grid ColumnDefinitions="*,Auto">
              <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,20,0">
                  <TextBlock Classes="h3" Text="{Binding Count, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" />
                  <TextBlock Classes="secondary" l:Tr.Text="to review" VerticalAlignment="Center" />
                  <TextBlock Classes="secondary" Text="{Binding SelectionText}" IsVisible="{Binding HasSelection}" VerticalAlignment="Center" />
                </StackPanel>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <Button Classes="secondary" l:Tr.Content="Not sensitive" Command="{Binding NotSensitiveCommand}" />
                <Button Classes="secondary danger" Command="{Binding DeleteCommand}" l:Tr.Tip="Move to the trash in Immich">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                    <TextBlock l:Tr.Text="Delete" />
                  </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding MoveToLockedCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="LockOutline" Width="16" Height="16" />
                    <TextBlock l:Tr.Text="Move to locked folder" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          </Grid>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</UserControl>
